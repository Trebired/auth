{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/auth",
  "version": "0.9.0",
  "description": "Authentication and permissions for Trebired apps: password credentials, session tokens and cookies, login sessions, TOTP two-factor, backup and activation codes, and a role-based permission engine, wired through .trebired/auth/config.ts.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./express": {
      "import": "./dist/express/index.js",
      "types": "./dist/express/index.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs",
    "prepare:generated": "bun node_modules/@trebired/code-discipline/dist/cli.js fix imports",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:auth",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:auth": "bun ./scripts/verify/auth.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.6.0",
    "@trebired/result": "^1.2.8",
    "@trebired/utils": "^0.9.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^7.2.3",
    "@trebired/configs": "^0.4.0",
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "auth",
    "authentication",
    "permissions",
    "sessions",
    "totp",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/auth"
  },
  "homepage": "https://github.com/Trebired/auth#readme",
  "bugs": {
    "url": "https://github.com/Trebired/auth/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
